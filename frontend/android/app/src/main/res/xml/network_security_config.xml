<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP for local development backend.
        MIUI (Xiaomi), ColorOS (OPPO/Realme) and HyperOS block cleartext traffic
        by default even when android:usesCleartextTraffic="true" is set.
        This config explicitly whitelists the local network range.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local network IP ranges for dev backend -->
        <domain includeSubdomains="true">192.168.0.36</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Production: enforce HTTPS for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
